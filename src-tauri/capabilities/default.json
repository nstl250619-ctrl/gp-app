{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "main 窗口默认能力：core 默认权限 + 本工具自定义命令",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "log:default",
    "opener:default",
    "updater:default",
    "process:default",
    "process:allow-restart",
    "allow-instance-probe",
    "allow-app-status",
    "allow-app-open-external",
    "allow-app-track-event",
    "allow-install-detect",
    "allow-install-plan",
    "allow-install-apply",
    "allow-install-rollback",
    "allow-install-history",
    "allow-credential-status",
    "allow-credential-clear",
    "allow-account-login",
    "allow-account-logout",
    "allow-account-status",
    "allow-account-setup-key",
    "allow-account-send-code",
    "allow-account-register",
    "allow-account-send-password-reset",
    "allow-account-reset-password",
    "allow-account-list-keys",
    "allow-account-select-key",
    "allow-account-link-status",
    "allow-usage-get-quota",
    "allow-usage-topups",
    "allow-usage-redemption-records",
    "allow-usage-detail",
    "allow-shop-status",
    "allow-shop-wallet",
    "allow-shop-send-bind-code",
    "allow-shop-bind",
    "allow-shop-sso-url",
    "allow-redeem-redeem"
  ]
}
